# Copy this file to .env.development and .env.production
# then set your Cloudflare Worker URL below.
#
# .env.development  → used by: pnpm dev
# .env.production   → used by: pnpm build
#
# Get this URL after running: pnpm --filter @ab-platform/worker deploy

VITE_API_URL=https://ab-testing-worker.YOUR-SUBDOMAIN.workers.dev
